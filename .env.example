POSTGRES_USER=cams_admin
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_DB=cams_db

NODE_ENV=development

# WebAuthn: RP_ID = hostname the PWA runs on, WEBAUTHN_ORIGIN = full origin(s), comma-separated
RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
STUDENT_EMAIL_DOMAIN=cdti.ac.th
# Required in production: long random secret used to hash OTP codes
OTP_PEPPER=

# Institution SMTP. Leave SMTP_HOST empty in development to print OTP mails to the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
