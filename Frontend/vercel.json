{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://cams-geofence-api.onrender.com/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ]
}
